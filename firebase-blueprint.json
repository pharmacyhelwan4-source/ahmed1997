{
  "entities": {
    "Employee": {
      "title": "Employee",
      "description": "A staff member of the pharmacy.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "name": { "type": "string", "description": "Full name of the employee" },
        "email": { "type": "string", "description": "Email address" },
        "role": { "type": "string", "enum": ["admin", "staff"], "description": "User role" },
        "isActive": { "type": "boolean", "description": "Whether the employee is active" }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "Notebook": {
      "title": "Notebook",
      "description": "A computer or invoice notebook tracking record.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["computer", "invoice"], "description": "Type of the notebook" },
        "month": { "type": "number", "description": "Month of the notebook (1-12)" },
        "year": { "type": "number", "description": "Year of the notebook" },
        "computerNumber": { "type": "number", "description": "Computer number (e.g., 1, 2, ...)" },
        "invoiceBookNumber": { "type": "number", "description": "The related invoice book number" },
        "serialStart": { "type": "number", "description": "Start of the serial range" },
        "serialEnd": { "type": "number", "description": "End of the serial range" },
        "assignedTo": { "type": "string", "description": "UID of the assigned employee" },
        "assignedBy": { "type": "string", "description": "UID of the admin who assigned it" },
        "currentStage": { "type": "string", "enum": ["writing", "pricing", "coding", "review", "stamping", "cutting", "delivery", "completed"], "description": "Current processing stage" },
        "stages": {
          "type": "object",
          "description": "Tracks completion of each stage",
          "properties": {
            "writing": { "$ref": "#/entities/StageInfo" },
            "pricing": { "$ref": "#/entities/StageInfo" },
            "coding": { "$ref": "#/entities/StageInfo" },
            "review": { "$ref": "#/entities/StageInfo" },
            "stamping": { "$ref": "#/entities/StageInfo" },
            "cutting": { "$ref": "#/entities/StageInfo" },
            "delivery": { "$ref": "#/entities/StageInfo" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "month", "year", "computerNumber", "currentStage", "createdAt"]
    },
    "StageInfo": {
      "title": "Stage Information",
      "type": "object",
      "properties": {
        "completed": { "type": "boolean" },
        "completedAt": { "type": "string", "format": "date-time" },
        "completedBy": { "type": "string" }
      }
    },
    "Log": {
      "title": "Log",
      "description": "Activity log for notebook changes.",
      "type": "object",
      "properties": {
        "notebookId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["notebookId", "userId", "action", "timestamp"]
    }
  },
  "firestore": {
    "/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Stored employee profiles."
    },
    "/notebooks/{notebookId}": {
      "schema": "Notebook",
      "description": "Main collection for tracking notebooks."
    },
    "/logs/{logId}": {
      "schema": "Log",
      "description": "Audit trail for system actions."
    }
  }
}
